NODE_ENV=development
PORT=4000
DATABASE_URL="postgresql://dar_el_baraka_user:<URL_ENCODED_PASSWORD>@<DEV_DB_HOST>:5433/dar_el_baraka?schema=public"
SESSION_COOKIE_NAME=deb_session
SESSION_TTL_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Login attempts per client address per window.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Soft ceiling on every route per client address per window.
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# Number of reverse-proxy hops in front of the API (1 behind nginx or Caddy,
# 0 when exposed directly). Without it every user behind the proxy shares one
# rate-limit bucket.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable log lines for a terminal; production must keep JSON.
LOG_PRETTY=true
# Commit identifier reported by the health endpoints (set by the deployment).
GIT_SHA=

# Days an idempotency record is kept before the cleanup job removes it.
IDEMPOTENCY_TTL_DAYS=7
# Socket timeouts and shutdown grace, in milliseconds.
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
