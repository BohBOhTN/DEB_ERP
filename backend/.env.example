NODE_ENV=development
PORT=4000
# Pool size and acquisition timeout are connection-string parameters. Ten
# connections cover one API instance; raise connection_limit only with the
# database's max_connections in mind.
DATABASE_URL="postgresql://dar_el_baraka_user:<URL_ENCODED_PASSWORD>@<DEV_DB_HOST>:5433/dar_el_baraka?schema=public&connection_limit=10&pool_timeout=10"
# Queries at or above this many milliseconds are logged as slow.
SLOW_QUERY_MS=200
# Effective permissions are cached in memory this long (ms); every access
# change invalidates the cache immediately.
PERMISSION_CACHE_TTL_MS=60000
# A session's last-used timestamp is written at most this often (ms).
SESSION_TOUCH_INTERVAL_MS=300000
SESSION_COOKIE_NAME=deb_session
SESSION_TTL_MINUTES=480
# Secure cookie: on by default in production. Set false only while the app is
# reached over plain HTTP on an address (see deploy/README.md).
SESSION_COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Login attempts per client address per window.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
# Soft ceiling on every route per client address per window.
GLOBAL_RATE_LIMIT_MAX=600
GLOBAL_RATE_LIMIT_WINDOW_MS=60000

# Number of reverse-proxy hops in front of the API (1 behind nginx or Caddy,
# 0 when exposed directly). Without it every user behind the proxy shares one
# rate-limit bucket.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Human-readable log lines for a terminal; production must keep JSON.
LOG_PRETTY=true
# Commit identifier reported by the health endpoints (set by the deployment).
GIT_SHA=

# Days an idempotency record is kept before the cleanup job removes it.
IDEMPOTENCY_TTL_DAYS=7
# Socket timeouts and shutdown grace, in milliseconds.
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
