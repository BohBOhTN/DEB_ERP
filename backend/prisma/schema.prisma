// PROTECTED OBJECTS
// Some invariants live only in hand-written migration SQL because Prisma cannot
// express them: partial unique indexes (one active name per catalogue entry,
// one main stock location, unique product code/barcode when present), the
// document-number sequences, and the pg_trgm extension. They are listed in
// prisma/protected-objects.json and guarded in CI. Never let `prisma migrate
// dev` drop them; review every generated migration for DROP statements.
//
// Identifier strategy (ADR-V2-001): existing tables keep cuid() primary keys;
// every table added from Sprint 17 on uses uuid(7) with @db.Uuid.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  displayName   String        @map("display_name")
  passwordHash  String        @map("password_hash")
  isActive      Boolean       @default(true) @map("is_active")
  deactivatedAt DateTime?     @map("deactivated_at")
  version       Int           @default(1)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      AuthSession[]
  roles         UserRole[]
  auditEvents   AuditEvent[]  @relation("AuditActor")

  @@index([isActive])
  @@map("users")
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Permission {
  key           String           @id
  module        String
  labelFr       String           @map("label_fr")
  descriptionFr String           @map("description_fr")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  roles         RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id          String           @id @default(cuid())
  name        String
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  isSystem    Boolean          @default(false) @map("is_system")
  systemKey   String?          @unique @map("system_key")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]

  @@index([isActive])
  @@map("roles")
}

model RolePermission {
  roleId        String     @map("role_id")
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  createdAt     DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String?  @map("actor_user_id")
  action        String
  entity        String
  targetId      String?  @map("target_id")
  correlationId String?  @map("correlation_id")
  reason        String?
  before        Json?
  after         Json?
  createdAt     DateTime @default(now()) @map("created_at")
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entity, targetId])
  @@index([createdAt])
  @@index([action])
  @@index([correlationId])
  @@index([targetId])
  @@map("audit_events")
}

model Unit {
  id                     String                      @id @default(cuid())
  code                   String                      @unique
  name                   String
  symbol                 String
  precision              Int                         @default(3)
  isActive               Boolean                     @default(true) @map("is_active")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  products               Product[]
  rawMaterials           RawMaterial[]
  rawMaterialConversions RawMaterialUnitConversion[]
  inventoryMovements     InventoryMovement[]
  purchaseLinesEntered   PurchaseLine[]              @relation("PurchaseLineEnteredUnit")
  purchaseLinesBase      PurchaseLine[]              @relation("PurchaseLineBaseUnit")
  saleLines              SaleLine[]
  customerOrderLines     CustomerOrderLine[]
  distributorSaleLines   DistributorSaleLine[]
  dispatchLines          DistributorDispatchLine[]
  settlementLines        DistributorSettlementLine[]
  simulationOutputs      CostSimulation[]            @relation("CostSimulationOutputUnit")
  simulationEnteredUnits CostSimulationIngredient[]  @relation("CostSimulationEnteredUnit")
  simulationPriceUnits   CostSimulationIngredient[]  @relation("CostSimulationPriceBasisUnit")

  @@index([isActive])
  @@map("units")
}

model ProductCategory {
  id              String    @id @default(cuid())
  name            String
  normalizedName  String    @map("normalized_name")
  description     String?
  isActive        Boolean   @default(true) @map("is_active")
  createdByUserId String    @map("created_by_user_id")
  updatedByUserId String    @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  products        Product[]

  @@index([isActive])
  @@index([normalizedName])
  @@map("product_categories")
}

model Product {
  id                   String                      @id @default(cuid())
  code                 String?
  barcode              String?
  name                 String
  normalizedName       String                      @map("normalized_name")
  categoryId           String                      @map("category_id")
  baseUnitId           String                      @map("base_unit_id")
  salePriceTnd         Decimal                     @map("sale_price_tnd") @db.Decimal(12, 3)
  isStockable          Boolean                     @default(true) @map("is_stockable")
  isActive             Boolean                     @default(true) @map("is_active")
  notes                String?
  version              Int                         @default(1)
  createdByUserId      String                      @map("created_by_user_id")
  updatedByUserId      String                      @map("updated_by_user_id")
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")
  category             ProductCategory             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUnit             Unit                        @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  inventoryMovements   InventoryMovement[]
  saleLines            SaleLine[]
  customerOrderLines   CustomerOrderLine[]
  distributorSaleLines DistributorSaleLine[]
  dispatchLines        DistributorDispatchLine[]
  settlementLines      DistributorSettlementLine[]
  costSimulations      CostSimulation[]

  @@index([categoryId])
  @@index([baseUnitId])
  @@index([isActive])
  @@index([normalizedName])
  @@index([name])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_normalized_name_trgm_idx")
  @@index([code(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_code_trgm_idx")
  @@index([barcode(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_barcode_trgm_idx")
  @@map("products")
}

model RawMaterial {
  id                 String                      @id @default(cuid())
  code               String?
  name               String
  normalizedName     String                      @map("normalized_name")
  category           String?
  baseUnitId         String                      @map("base_unit_id")
  isActive           Boolean                     @default(true) @map("is_active")
  notes              String?
  version            Int                         @default(1)
  createdByUserId    String                      @map("created_by_user_id")
  updatedByUserId    String                      @map("updated_by_user_id")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  baseUnit           Unit                        @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  conversions        RawMaterialUnitConversion[]
  inventoryMovements InventoryMovement[]
  purchaseLines      PurchaseLine[]
  simulationLines    CostSimulationIngredient[]

  @@index([baseUnitId])
  @@index([isActive])
  @@index([normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "raw_materials_normalized_name_trgm_idx")
  @@map("raw_materials")
}

model RawMaterialUnitConversion {
  id            String      @id @default(cuid())
  rawMaterialId String      @map("raw_material_id")
  unitId        String      @map("unit_id")
  factorToBase  Decimal     @map("factor_to_base") @db.Decimal(18, 6)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([rawMaterialId, unitId])
  @@index([unitId])
  @@index([isActive])
  @@map("raw_material_unit_conversions")
}

model StockLocation {
  id                 String              @id @default(cuid())
  code               String              @unique
  name               String
  isMain             Boolean             @default(false) @map("is_main")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  inventoryMovements InventoryMovement[]

  @@index([isActive])
  @@map("stock_locations")
}

/// Where a stock movement came from. Closed set (BE-33).
enum InventorySourceType {
  OPENING_STOCK
  STOCK_ADJUSTMENT
  PURCHASE
  PURCHASE_CANCELLATION
  POS_SALE
  CUSTOMER_ORDER_SALE
  DISTRIBUTOR_DIRECT_SALE
  DISTRIBUTOR_DISPATCH
  DISTRIBUTOR_SETTLEMENT
}

model InventoryMovement {
  id               String                @id @default(cuid())
  locationId       String                @map("location_id")
  itemType         InventoryItemType     @map("item_type")
  productId        String?               @map("product_id")
  rawMaterialId    String?               @map("raw_material_id")
  unitId           String                @map("unit_id")
  movementType     InventoryMovementType @map("movement_type")
  quantityDelta    Decimal               @map("quantity_delta") @db.Decimal(18, 6)
  itemNameSnapshot String                @map("item_name_snapshot")
  unitNameSnapshot String                @map("unit_name_snapshot")
  sourceType       InventorySourceType   @map("source_type")
  sourceId         String?               @map("source_id")
  reason           String?
  occurredAt       DateTime              @default(now()) @map("occurred_at")
  actorUserId      String                @map("actor_user_id")
  correlationId    String?               @map("correlation_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  location         StockLocation         @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product          Product?              @relation(fields: [productId], references: [id], onDelete: Restrict)
  rawMaterial      RawMaterial?          @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  unit             Unit                  @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([locationId])
  @@index([productId])
  @@index([rawMaterialId])
  @@index([unitId])
  @@index([movementType])
  @@index([occurredAt])
  @@index([sourceType])
  @@map("inventory_movements")
}

enum InventoryItemType {
  PRODUCT
  RAW_MATERIAL
}

enum InventoryMovementType {
  OPENING_STOCK
  PURCHASE_RECEIPT
  POS_SALE
  ORDER_SALE
  DISTRIBUTOR_DIRECT_SALE
  DISTRIBUTOR_DISPATCH_OUT
  DISTRIBUTOR_RETURN_IN
  DISTRIBUTOR_SETTLED_SALE
  STOCK_ADJUSTMENT_INCREASE
  STOCK_ADJUSTMENT_DECREASE
  REVERSAL
}

model Supplier {
  id              String                @id @default(cuid())
  name            String
  normalizedName  String                @map("normalized_name")
  phone           String?
  address         String?
  taxIdentifier   String?               @map("tax_identifier")
  notes           String?
  isActive        Boolean               @default(true) @map("is_active")
  version         Int                   @default(1)
  createdByUserId String                @map("created_by_user_id")
  updatedByUserId String                @map("updated_by_user_id")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  purchases       Purchase[]
  payments        SupplierPayment[]
  ledgerEntries   SupplierLedgerEntry[]

  @@index([isActive])
  @@index([normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "suppliers_normalized_name_trgm_idx")
  @@map("suppliers")
}

model Purchase {
  id                 String                      @id @default(cuid())
  /// Human document number, AC-000001, assigned when the draft is posted.
  reference          String?                     @unique
  supplierId         String                      @map("supplier_id")
  purchaseDate       DateTime                    @map("purchase_date")
  supplierReference  String?                     @map("supplier_reference")
  status             PurchaseStatus              @default(DRAFT)
  paymentTerms       PurchasePaymentTerms        @map("payment_terms")
  dueDate            DateTime?                   @map("due_date")
  totalTnd           Decimal                     @default(0) @map("total_tnd") @db.Decimal(14, 3)
  paidAmountTnd      Decimal                     @default(0) @map("paid_amount_tnd") @db.Decimal(14, 3)
  /// Projection of the supplier ledger for this purchase (GOV-006): kept in
  /// step with every payment, allocation and reversal that names it.
  remainingDueTnd    Decimal                     @default(0) @map("remaining_due_tnd") @db.Decimal(14, 3)
  notes              String?
  postedAt           DateTime?                   @map("posted_at")
  postedByUserId     String?                     @map("posted_by_user_id")
  cancelledAt        DateTime?                   @map("cancelled_at")
  cancelledByUserId  String?                     @map("cancelled_by_user_id")
  cancellationReason String?                     @map("cancellation_reason")
  correlationId      String?                     @map("correlation_id")
  createdByUserId    String                      @map("created_by_user_id")
  updatedByUserId    String                      @map("updated_by_user_id")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  supplier           Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines              PurchaseLine[]
  payments           SupplierPayment[]
  ledgerEntries      SupplierLedgerEntry[]
  paymentAllocations SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([purchaseDate])
  @@index([status])
  @@index([dueDate])
  @@index([paymentTerms])
  @@index([status, dueDate])
  @@map("purchases")
}

model PurchaseLine {
  id                      String      @id @default(cuid())
  purchaseId              String      @map("purchase_id")
  rawMaterialId           String      @map("raw_material_id")
  enteredUnitId           String      @map("entered_unit_id")
  baseUnitId              String      @map("base_unit_id")
  enteredQuantity         Decimal     @map("entered_quantity") @db.Decimal(18, 6)
  conversionFactorToBase  Decimal     @map("conversion_factor_to_base") @db.Decimal(18, 6)
  normalizedQuantity      Decimal     @map("normalized_quantity") @db.Decimal(18, 6)
  unitPriceTnd            Decimal     @map("unit_price_tnd") @db.Decimal(14, 3)
  lineTotalTnd            Decimal     @map("line_total_tnd") @db.Decimal(14, 3)
  rawMaterialNameSnapshot String      @map("raw_material_name_snapshot")
  enteredUnitNameSnapshot String      @map("entered_unit_name_snapshot")
  baseUnitNameSnapshot    String      @map("base_unit_name_snapshot")
  createdAt               DateTime    @default(now()) @map("created_at")
  purchase                Purchase    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial             RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  enteredUnit             Unit        @relation("PurchaseLineEnteredUnit", fields: [enteredUnitId], references: [id], onDelete: Restrict)
  baseUnit                Unit        @relation("PurchaseLineBaseUnit", fields: [baseUnitId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@index([enteredUnitId])
  @@index([baseUnitId])
  @@map("purchase_lines")
}

/// One method for every money movement (OD-014 keeps cash only in V1/V2).
enum PaymentMethod {
  CASH
}

model SupplierPayment {
  id               String                      @id @default(cuid())
  supplierId       String                      @map("supplier_id")
  purchaseId       String?                     @map("purchase_id")
  amountTnd        Decimal                     @map("amount_tnd") @db.Decimal(14, 3)
  method           PaymentMethod               @default(CASH)
  paidAt           DateTime                    @map("paid_at")
  reference        String?
  notes            String?
  actorUserId      String                      @map("actor_user_id")
  correlationId    String?                     @map("correlation_id")
  /// A reversed payment stays visible; its ledger effect is compensated by
  /// PAYMENT_REVERSAL entries written when it was reversed.
  reversedAt       DateTime?                   @map("reversed_at")
  reversedByUserId String?                     @map("reversed_by_user_id")
  reversalReason   String?                     @map("reversal_reason")
  createdAt        DateTime                    @default(now()) @map("created_at")
  supplier         Supplier                    @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase         Purchase?                   @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  ledgerEntries    SupplierLedgerEntry[]
  allocations      SupplierPaymentAllocation[]

  @@index([supplierId])
  @@index([purchaseId])
  @@index([paidAt])
  @@index([supplierId, paidAt])
  @@map("supplier_payments")
}

model SupplierPaymentAllocation {
  id         String          @id @default(cuid())
  paymentId  String          @map("payment_id")
  purchaseId String          @map("purchase_id")
  amountTnd  Decimal         @map("amount_tnd") @db.Decimal(14, 3)
  createdAt  DateTime        @default(now()) @map("created_at")
  payment    SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  purchase   Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Restrict)

  @@unique([paymentId, purchaseId])
  @@index([purchaseId])
  @@map("supplier_payment_allocations")
}

model SupplierLedgerEntry {
  id            String                  @id @default(cuid())
  supplierId    String                  @map("supplier_id")
  purchaseId    String?                 @map("purchase_id")
  paymentId     String?                 @map("payment_id")
  entryType     SupplierLedgerEntryType @map("entry_type")
  amountTnd     Decimal                 @map("amount_tnd") @db.Decimal(14, 3)
  occurredAt    DateTime                @map("occurred_at")
  actorUserId   String                  @map("actor_user_id")
  correlationId String?                 @map("correlation_id")
  createdAt     DateTime                @default(now()) @map("created_at")
  supplier      Supplier                @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  purchase      Purchase?               @relation(fields: [purchaseId], references: [id], onDelete: Restrict)
  payment       SupplierPayment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([supplierId])
  @@index([purchaseId])
  @@index([paymentId])
  @@index([occurredAt])
  @@map("supplier_ledger_entries")
}

enum PurchaseStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum PurchasePaymentTerms {
  PAID
  PARTIAL
  UNPAID
}

enum SupplierLedgerEntryType {
  PURCHASE_PAYABLE
  PAYMENT
  PURCHASE_REVERSAL
  PAYMENT_REVERSAL
}

model PosTerminal {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  sessions  PosSession[]

  @@index([isActive])
  @@map("pos_terminals")
}

model Customer {
  id              String                 @id @default(cuid())
  name            String
  normalizedName  String                 @map("normalized_name")
  phone           String?
  address         String?
  taxIdentifier   String?                @map("tax_identifier")
  notes           String?
  isActive        Boolean                @default(true) @map("is_active")
  version         Int                    @default(1)
  createdByUserId String                 @map("created_by_user_id")
  updatedByUserId String                 @map("updated_by_user_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  sales           Sale[]
  payments        CustomerPayment[]
  ledgerEntries   CustomerLedgerEntry[]
  orders          CustomerOrder[]
  orderAdvances   CustomerOrderAdvance[]

  @@index([isActive])
  @@index([normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_normalized_name_trgm_idx")
  @@index([phone(ops: raw("gin_trgm_ops"))], type: Gin, map: "customers_phone_trgm_idx")
  @@map("customers")
}

model PosSession {
  id                       String                 @id @default(cuid())
  terminalId               String                 @map("terminal_id")
  status                   PosSessionStatus       @default(OPEN)
  openedAt                 DateTime               @map("opened_at")
  openedByUserId           String                 @map("opened_by_user_id")
  openingCashTnd           Decimal                @map("opening_cash_tnd") @db.Decimal(14, 3)
  closedAt                 DateTime?              @map("closed_at")
  closedByUserId           String?                @map("closed_by_user_id")
  countedCashTnd           Decimal?               @map("counted_cash_tnd") @db.Decimal(14, 3)
  expectedCashTnd          Decimal?               @map("expected_cash_tnd") @db.Decimal(14, 3)
  cashDifferenceTnd        Decimal?               @map("cash_difference_tnd") @db.Decimal(14, 3)
  notes                    String?
  correlationId            String?                @map("correlation_id")
  createdAt                DateTime               @default(now()) @map("created_at")
  updatedAt                DateTime               @updatedAt @map("updated_at")
  terminal                 PosTerminal            @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  sales                    Sale[]
  payments                 SalePayment[]
  orderAdvances            CustomerOrderAdvance[]
  customerPayments         CustomerPayment[]      @relation("CustomerPaymentSession")
  reversedCustomerPayments CustomerPayment[]      @relation("CustomerPaymentReversalSession")

  @@index([terminalId])
  @@index([status])
  @@index([openedAt])
  @@map("pos_sessions")
}

model Sale {
  id                 String                      @id @default(cuid())
  /// Human document number, VT-000001, assigned at posting.
  reference          String                      @unique
  sessionId          String                      @map("session_id")
  customerId         String?                     @map("customer_id")
  status             SaleStatus                  @default(POSTED)
  paymentState       SalePaymentState            @default(PAID) @map("payment_state")
  soldAt             DateTime                    @map("sold_at")
  totalTnd           Decimal                     @map("total_tnd") @db.Decimal(14, 3)
  paidAmountTnd      Decimal                     @map("paid_amount_tnd") @db.Decimal(14, 3)
  remainingDueTnd    Decimal                     @default(0) @map("remaining_due_tnd") @db.Decimal(14, 3)
  postedAt           DateTime                    @map("posted_at")
  postedByUserId     String                      @map("posted_by_user_id")
  correlationId      String?                     @map("correlation_id")
  createdAt          DateTime                    @default(now()) @map("created_at")
  updatedAt          DateTime                    @updatedAt @map("updated_at")
  session            PosSession                  @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  customer           Customer?                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  lines              SaleLine[]
  payments           SalePayment[]
  ledgerEntries      CustomerLedgerEntry[]
  paymentAllocations CustomerPaymentAllocation[]
  order              CustomerOrder?

  @@index([sessionId])
  @@index([customerId])
  @@index([status])
  @@index([soldAt])
  @@index([paymentState])
  @@index([postedByUserId])
  @@index([sessionId, postedAt])
  @@map("sales")
}

model SaleLine {
  id                  String   @id @default(cuid())
  saleId              String   @map("sale_id")
  productId           String   @map("product_id")
  unitId              String   @map("unit_id")
  quantity            Decimal  @db.Decimal(18, 6)
  unitPriceTnd        Decimal  @map("unit_price_tnd") @db.Decimal(14, 3)
  lineTotalTnd        Decimal  @map("line_total_tnd") @db.Decimal(14, 3)
  productNameSnapshot String   @map("product_name_snapshot")
  unitNameSnapshot    String   @map("unit_name_snapshot")
  createdAt           DateTime @default(now()) @map("created_at")
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit                Unit     @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@index([unitId])
  @@map("sale_lines")
}

model SalePayment {
  id            String        @id @default(cuid())
  saleId        String        @map("sale_id")
  sessionId     String        @map("session_id")
  amountTnd     Decimal       @map("amount_tnd") @db.Decimal(14, 3)
  method        PaymentMethod @default(CASH)
  paidAt        DateTime      @map("paid_at")
  actorUserId   String        @map("actor_user_id")
  correlationId String?       @map("correlation_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Restrict)
  session       PosSession    @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([sessionId])
  @@index([paidAt])
  @@map("sale_payments")
}

model CustomerPayment {
  id                  String                      @id @default(cuid())
  customerId          String                      @map("customer_id")
  /// Set only when the money was taken at the till, so the POS close can
  /// reconcile the drawer against what actually passed through it. A
  /// back-office payment leaves this null and never touches the session.
  sessionId           String?                     @map("session_id")
  amountTnd           Decimal                     @map("amount_tnd") @db.Decimal(14, 3)
  method              PaymentMethod               @default(CASH)
  paidAt              DateTime                    @map("paid_at")
  reference           String?
  notes               String?
  actorUserId         String                      @map("actor_user_id")
  correlationId       String?                     @map("correlation_id")
  /// A reversed payment stays visible; its ledger effect is compensated by
  /// PAYMENT_REVERSAL entries. A règlement taken at the till and reversed
  /// later leaves the drawer of the session it was reversed in.
  reversedAt          DateTime?                   @map("reversed_at")
  reversedByUserId    String?                     @map("reversed_by_user_id")
  reversalReason      String?                     @map("reversal_reason")
  reversedInSessionId String?                     @map("reversed_in_session_id")
  createdAt           DateTime                    @default(now()) @map("created_at")
  customer            Customer                    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  session             PosSession?                 @relation("CustomerPaymentSession", fields: [sessionId], references: [id], onDelete: Restrict)
  reversedInSession   PosSession?                 @relation("CustomerPaymentReversalSession", fields: [reversedInSessionId], references: [id], onDelete: Restrict)
  ledgerEntries       CustomerLedgerEntry[]
  allocations         CustomerPaymentAllocation[]

  @@index([customerId])
  @@index([sessionId])
  @@index([paidAt])
  @@index([customerId, paidAt])
  @@index([reversedInSessionId])
  @@map("customer_payments")
}

model CustomerPaymentAllocation {
  id        String          @id @default(cuid())
  paymentId String          @map("payment_id")
  saleId    String          @map("sale_id")
  amountTnd Decimal         @map("amount_tnd") @db.Decimal(14, 3)
  createdAt DateTime        @default(now()) @map("created_at")
  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale      Sale            @relation(fields: [saleId], references: [id], onDelete: Restrict)

  @@unique([paymentId, saleId])
  @@index([saleId])
  @@map("customer_payment_allocations")
}

model CustomerLedgerEntry {
  id            String                    @id @default(cuid())
  customerId    String                    @map("customer_id")
  saleId        String?                   @map("sale_id")
  paymentId     String?                   @map("payment_id")
  orderId       String?                   @map("order_id")
  balanceKind   CustomerLedgerBalanceKind @default(RECEIVABLE) @map("balance_kind")
  entryType     CustomerLedgerEntryType   @map("entry_type")
  amountTnd     Decimal                   @map("amount_tnd") @db.Decimal(14, 3)
  occurredAt    DateTime                  @map("occurred_at")
  actorUserId   String                    @map("actor_user_id")
  correlationId String?                   @map("correlation_id")
  createdAt     DateTime                  @default(now()) @map("created_at")
  customer      Customer                  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale          Sale?                     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  payment       CustomerPayment?          @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  order         CustomerOrder?            @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([saleId])
  @@index([paymentId])
  @@index([orderId])
  @@index([balanceKind])
  @@index([occurredAt])
  @@index([customerId, balanceKind])
  @@map("customer_ledger_entries")
}

/// A customer order is a commitment to fulfil later. It is not a sale: it
/// recognizes no revenue and moves no stock until completion creates exactly
/// one linked sale.
model CustomerOrder {
  id                     String                           @id @default(cuid())
  reference              String                           @unique
  customerId             String                           @map("customer_id")
  status                 CustomerOrderStatus              @default(DRAFT)
  requestedFulfillmentAt DateTime                         @map("requested_fulfillment_at")
  totalTnd               Decimal                          @map("total_tnd") @db.Decimal(14, 3)
  advanceBalanceTnd      Decimal                          @default(0) @map("advance_balance_tnd") @db.Decimal(14, 3)
  notes                  String?
  version                Int                              @default(1)
  saleId                 String?                          @unique @map("sale_id")
  completedAt            DateTime?                        @map("completed_at")
  completedByUserId      String?                          @map("completed_by_user_id")
  cancelledAt            DateTime?                        @map("cancelled_at")
  cancelledByUserId      String?                          @map("cancelled_by_user_id")
  cancellationReason     String?                          @map("cancellation_reason")
  advanceDisposition     CustomerOrderAdvanceDisposition? @map("advance_disposition")
  createdByUserId        String                           @map("created_by_user_id")
  updatedByUserId        String                           @map("updated_by_user_id")
  correlationId          String?                          @map("correlation_id")
  createdAt              DateTime                         @default(now()) @map("created_at")
  updatedAt              DateTime                         @updatedAt @map("updated_at")
  customer               Customer                         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  sale                   Sale?                            @relation(fields: [saleId], references: [id], onDelete: Restrict)
  lines                  CustomerOrderLine[]
  advances               CustomerOrderAdvance[]
  ledgerEntries          CustomerLedgerEntry[]

  @@index([customerId])
  @@index([status])
  @@index([requestedFulfillmentAt])
  @@index([status, requestedFulfillmentAt])
  @@map("customer_orders")
}

model CustomerOrderLine {
  id                  String        @id @default(cuid())
  orderId             String        @map("order_id")
  productId           String        @map("product_id")
  unitId              String        @map("unit_id")
  quantity            Decimal       @db.Decimal(18, 6)
  unitPriceTnd        Decimal       @map("unit_price_tnd") @db.Decimal(14, 3)
  lineTotalTnd        Decimal       @map("line_total_tnd") @db.Decimal(14, 3)
  productNameSnapshot String        @map("product_name_snapshot")
  unitNameSnapshot    String        @map("unit_name_snapshot")
  createdAt           DateTime      @default(now()) @map("created_at")
  order               CustomerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit                Unit          @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([orderId])
  @@index([productId])
  @@index([unitId])
  @@map("customer_order_lines")
}

/// Money moved before fulfilment. A RECEIPT is a customer advance, never sale
/// revenue; a REFUND returns an advance when a paid order is cancelled.
model CustomerOrderAdvance {
  id            String                       @id @default(cuid())
  orderId       String                       @map("order_id")
  customerId    String                       @map("customer_id")
  sessionId     String                       @map("session_id")
  movement      CustomerOrderAdvanceMovement @default(RECEIPT)
  amountTnd     Decimal                      @map("amount_tnd") @db.Decimal(14, 3)
  method        PaymentMethod                @default(CASH)
  paidAt        DateTime                     @map("paid_at")
  notes         String?
  actorUserId   String                       @map("actor_user_id")
  correlationId String?                      @map("correlation_id")
  createdAt     DateTime                     @default(now()) @map("created_at")
  order         CustomerOrder                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  customer      Customer                     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  session       PosSession                   @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([customerId])
  @@index([sessionId])
  @@index([paidAt])
  @@map("customer_order_advances")
}

enum PosSessionStatus {
  OPEN
  CLOSED
}

enum SaleStatus {
  POSTED
  CANCELLED
}

enum SalePaymentState {
  PAID
  PARTIALLY_PAID
  UNPAID
}

enum CustomerLedgerEntryType {
  SALE_RECEIVABLE
  PAYMENT
  SALE_REVERSAL
  PAYMENT_REVERSAL
  ORDER_ADVANCE
  ORDER_ADVANCE_APPLIED
  ORDER_ADVANCE_REFUNDED
  ORDER_ADVANCE_CREDITED
}

/// Receivable and advance are two separate balances for the same customer.
/// An advance is money held for the customer; it must never net against
/// receivable implicitly.
enum CustomerLedgerBalanceKind {
  RECEIVABLE
  ADVANCE
}

enum CustomerOrderStatus {
  DRAFT
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum CustomerOrderAdvanceMovement {
  RECEIPT
  REFUND
}

enum CustomerOrderAdvanceDisposition {
  REFUNDED
  CREDITED
}

model Distributor {
  id              String                   @id @default(cuid())
  name            String
  normalizedName  String                   @map("normalized_name")
  phone           String?
  address         String?
  taxIdentifier   String?                  @map("tax_identifier")
  notes           String?
  isActive        Boolean                  @default(true) @map("is_active")
  version         Int                      @default(1)
  createdByUserId String                   @map("created_by_user_id")
  updatedByUserId String                   @map("updated_by_user_id")
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  sales           DistributorSale[]
  dispatches      DistributorDispatch[]
  settlements     DistributorSettlement[]
  payments        DistributorPayment[]
  ledgerEntries   DistributorLedgerEntry[]

  @@index([isActive])
  @@index([normalizedName])
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "distributors_normalized_name_trgm_idx")
  @@map("distributors")
}

/// A direct sale to a distributor. Unlike consignment it behaves like any
/// sale: stock leaves immediately and revenue is recognized once.
model DistributorSale {
  id                 String                         @id @default(cuid())
  reference          String                         @unique
  distributorId      String                         @map("distributor_id")
  status             SaleStatus                     @default(POSTED)
  paymentState       SalePaymentState               @map("payment_state")
  soldAt             DateTime                       @map("sold_at")
  totalTnd           Decimal                        @map("total_tnd") @db.Decimal(14, 3)
  paidAmountTnd      Decimal                        @map("paid_amount_tnd") @db.Decimal(14, 3)
  remainingDueTnd    Decimal                        @default(0) @map("remaining_due_tnd") @db.Decimal(14, 3)
  notes              String?
  postedAt           DateTime                       @map("posted_at")
  postedByUserId     String                         @map("posted_by_user_id")
  correlationId      String?                        @map("correlation_id")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  distributor        Distributor                    @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  lines              DistributorSaleLine[]
  ledgerEntries      DistributorLedgerEntry[]
  paymentAllocations DistributorPaymentAllocation[]

  @@index([distributorId])
  @@index([soldAt])
  @@index([status])
  @@map("distributor_sales")
}

model DistributorSaleLine {
  id                  String          @id @default(cuid())
  saleId              String          @map("sale_id")
  productId           String          @map("product_id")
  unitId              String          @map("unit_id")
  quantity            Decimal         @db.Decimal(18, 6)
  unitPriceTnd        Decimal         @map("unit_price_tnd") @db.Decimal(14, 3)
  lineTotalTnd        Decimal         @map("line_total_tnd") @db.Decimal(14, 3)
  productNameSnapshot String          @map("product_name_snapshot")
  unitNameSnapshot    String          @map("unit_name_snapshot")
  createdAt           DateTime        @default(now()) @map("created_at")
  sale                DistributorSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit                Unit            @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([saleId, productId])
  @@index([saleId])
  @@index([productId])
  @@index([unitId])
  @@map("distributor_sale_lines")
}

/// Consignment dispatch. Goods move into distributor custody but stay
/// bakery-owned, so this creates no sale, receivable, or payment.
model DistributorDispatch {
  id             String                    @id @default(cuid())
  reference      String                    @unique
  distributorId  String                    @map("distributor_id")
  status         DistributorDispatchStatus @default(OPEN)
  dispatchedAt   DateTime                  @map("dispatched_at")
  notes          String?
  version        Int                       @default(1)
  postedByUserId String                    @map("posted_by_user_id")
  correlationId  String?                   @map("correlation_id")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  distributor    Distributor               @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  lines          DistributorDispatchLine[]
  settlements    DistributorSettlement[]

  @@index([distributorId])
  @@index([status])
  @@index([dispatchedAt])
  @@map("distributor_dispatches")
}

/// Custody lives here. Still-held quantity is derived, never stored:
/// dispatched - settled sold - returned - unaccounted.
model DistributorDispatchLine {
  id                  String                      @id @default(cuid())
  dispatchId          String                      @map("dispatch_id")
  productId           String                      @map("product_id")
  unitId              String                      @map("unit_id")
  dispatchedQuantity  Decimal                     @map("dispatched_quantity") @db.Decimal(18, 6)
  settledSoldQuantity Decimal                     @default(0) @map("settled_sold_quantity") @db.Decimal(18, 6)
  returnedQuantity    Decimal                     @default(0) @map("returned_quantity") @db.Decimal(18, 6)
  unaccountedQuantity Decimal                     @default(0) @map("unaccounted_quantity") @db.Decimal(18, 6)
  productNameSnapshot String                      @map("product_name_snapshot")
  unitNameSnapshot    String                      @map("unit_name_snapshot")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")
  dispatch            DistributorDispatch         @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product             Product                     @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit                Unit                        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  settlementLines     DistributorSettlementLine[]

  @@unique([dispatchId, productId])
  @@index([dispatchId])
  @@index([productId])
  @@index([unitId])
  @@map("distributor_dispatch_lines")
}

/// Settlement classifies dispatched quantity. Only the sold part becomes
/// revenue and receivable; returns re-enter main stock; unaccounted quantity
/// is recorded as a discrepancy and never becomes automatic debt.
model DistributorSettlement {
  id                 String                         @id @default(cuid())
  reference          String                         @unique
  distributorId      String                         @map("distributor_id")
  dispatchId         String                         @map("dispatch_id")
  settledAt          DateTime                       @map("settled_at")
  totalTnd           Decimal                        @map("total_tnd") @db.Decimal(14, 3)
  paidAmountTnd      Decimal                        @map("paid_amount_tnd") @db.Decimal(14, 3)
  remainingDueTnd    Decimal                        @default(0) @map("remaining_due_tnd") @db.Decimal(14, 3)
  paymentState       SalePaymentState               @map("payment_state")
  notes              String?
  postedAt           DateTime                       @map("posted_at")
  postedByUserId     String                         @map("posted_by_user_id")
  correlationId      String?                        @map("correlation_id")
  createdAt          DateTime                       @default(now()) @map("created_at")
  updatedAt          DateTime                       @updatedAt @map("updated_at")
  distributor        Distributor                    @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  dispatch           DistributorDispatch            @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  lines              DistributorSettlementLine[]
  ledgerEntries      DistributorLedgerEntry[]
  paymentAllocations DistributorPaymentAllocation[]

  @@index([distributorId])
  @@index([dispatchId])
  @@index([settledAt])
  @@map("distributor_settlements")
}

model DistributorSettlementLine {
  id                  String                  @id @default(cuid())
  settlementId        String                  @map("settlement_id")
  dispatchLineId      String                  @map("dispatch_line_id")
  productId           String                  @map("product_id")
  unitId              String                  @map("unit_id")
  soldQuantity        Decimal                 @default(0) @map("sold_quantity") @db.Decimal(18, 6)
  returnedQuantity    Decimal                 @default(0) @map("returned_quantity") @db.Decimal(18, 6)
  unaccountedQuantity Decimal                 @default(0) @map("unaccounted_quantity") @db.Decimal(18, 6)
  unitPriceTnd        Decimal                 @map("unit_price_tnd") @db.Decimal(14, 3)
  lineTotalTnd        Decimal                 @map("line_total_tnd") @db.Decimal(14, 3)
  productNameSnapshot String                  @map("product_name_snapshot")
  unitNameSnapshot    String                  @map("unit_name_snapshot")
  createdAt           DateTime                @default(now()) @map("created_at")
  settlement          DistributorSettlement   @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  dispatchLine        DistributorDispatchLine @relation(fields: [dispatchLineId], references: [id], onDelete: Restrict)
  product             Product                 @relation(fields: [productId], references: [id], onDelete: Restrict)
  unit                Unit                    @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([settlementId, dispatchLineId])
  @@index([settlementId])
  @@index([dispatchLineId])
  @@index([productId])
  @@index([unitId])
  @@map("distributor_settlement_lines")
}

model DistributorPayment {
  id               String                         @id @default(cuid())
  distributorId    String                         @map("distributor_id")
  amountTnd        Decimal                        @map("amount_tnd") @db.Decimal(14, 3)
  method           PaymentMethod                  @default(CASH)
  paidAt           DateTime                       @map("paid_at")
  reference        String?
  notes            String?
  actorUserId      String                         @map("actor_user_id")
  correlationId    String?                        @map("correlation_id")
  /// A reversed payment stays visible; its ledger effect is compensated by
  /// PAYMENT_REVERSAL entries written when it was reversed.
  reversedAt       DateTime?                      @map("reversed_at")
  reversedByUserId String?                        @map("reversed_by_user_id")
  reversalReason   String?                        @map("reversal_reason")
  createdAt        DateTime                       @default(now()) @map("created_at")
  distributor      Distributor                    @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  allocations      DistributorPaymentAllocation[]
  ledgerEntries    DistributorLedgerEntry[]

  @@index([distributorId])
  @@index([paidAt])
  @@index([distributorId, paidAt])
  @@map("distributor_payments")
}

/// An allocation targets exactly one receivable document: a direct sale or a
/// settlement.
model DistributorPaymentAllocation {
  id           String                 @id @default(cuid())
  paymentId    String                 @map("payment_id")
  saleId       String?                @map("sale_id")
  settlementId String?                @map("settlement_id")
  amountTnd    Decimal                @map("amount_tnd") @db.Decimal(14, 3)
  createdAt    DateTime               @default(now()) @map("created_at")
  payment      DistributorPayment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  sale         DistributorSale?       @relation(fields: [saleId], references: [id], onDelete: Restrict)
  settlement   DistributorSettlement? @relation(fields: [settlementId], references: [id], onDelete: Restrict)

  @@unique([paymentId, saleId])
  @@unique([paymentId, settlementId])
  @@index([saleId])
  @@index([settlementId])
  @@map("distributor_payment_allocations")
}

model DistributorLedgerEntry {
  id            String                     @id @default(cuid())
  distributorId String                     @map("distributor_id")
  saleId        String?                    @map("sale_id")
  settlementId  String?                    @map("settlement_id")
  paymentId     String?                    @map("payment_id")
  entryType     DistributorLedgerEntryType @map("entry_type")
  amountTnd     Decimal                    @map("amount_tnd") @db.Decimal(14, 3)
  occurredAt    DateTime                   @map("occurred_at")
  actorUserId   String                     @map("actor_user_id")
  correlationId String?                    @map("correlation_id")
  createdAt     DateTime                   @default(now()) @map("created_at")
  distributor   Distributor                @relation(fields: [distributorId], references: [id], onDelete: Restrict)
  sale          DistributorSale?           @relation(fields: [saleId], references: [id], onDelete: Restrict)
  settlement    DistributorSettlement?     @relation(fields: [settlementId], references: [id], onDelete: Restrict)
  payment       DistributorPayment?        @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([distributorId])
  @@index([saleId])
  @@index([settlementId])
  @@index([paymentId])
  @@index([occurredAt])
  @@map("distributor_ledger_entries")
}

enum DistributorDispatchStatus {
  OPEN
  CLOSED
}

enum DistributorLedgerEntryType {
  SALE_RECEIVABLE
  SETTLEMENT_RECEIVABLE
  PAYMENT
  SALE_REVERSAL
  PAYMENT_REVERSAL
}

/// A planning-only scenario. SIM-003: it has no inventory, supplier, customer,
/// revenue, payment, or expense effect, and nothing here is ever posted.
model CostSimulation {
  id                        String                     @id @default(cuid())
  name                      String
  targetProductId           String?                    @map("target_product_id")
  outputQuantity            Decimal                    @map("output_quantity") @db.Decimal(18, 6)
  outputUnitId              String                     @map("output_unit_id")
  notes                     String?
  /// Stored results of the documented formulas so a saved scenario reads back
  /// exactly as it was calculated.
  totalIngredientCostTnd    Decimal                    @default(0) @map("total_ingredient_cost_tnd") @db.Decimal(14, 3)
  costPerOutputUnitTnd      Decimal                    @default(0) @map("cost_per_output_unit_tnd") @db.Decimal(14, 3)
  outputUnitNameSnapshot    String                     @map("output_unit_name_snapshot")
  targetProductNameSnapshot String?                    @map("target_product_name_snapshot")
  version                   Int                        @default(1)
  createdByUserId           String                     @map("created_by_user_id")
  updatedByUserId           String                     @map("updated_by_user_id")
  createdAt                 DateTime                   @default(now()) @map("created_at")
  updatedAt                 DateTime                   @updatedAt @map("updated_at")
  targetProduct             Product?                   @relation(fields: [targetProductId], references: [id], onDelete: Restrict)
  outputUnit                Unit                       @relation("CostSimulationOutputUnit", fields: [outputUnitId], references: [id], onDelete: Restrict)
  ingredients               CostSimulationIngredient[]

  @@index([targetProductId])
  @@index([outputUnitId])
  @@index([name])
  @@map("cost_simulations")
}

/// SIM-004: an ingredient may point at a raw material or be free text.
/// SIM-006: every entered value is snapshotted, so a later price or unit change
/// never rewrites a saved scenario.
model CostSimulationIngredient {
  id                         String         @id @default(cuid())
  simulationId               String         @map("simulation_id")
  rawMaterialId              String?        @map("raw_material_id")
  ingredientName             String         @map("ingredient_name")
  enteredQuantity            Decimal        @map("entered_quantity") @db.Decimal(18, 6)
  enteredUnitId              String         @map("entered_unit_id")
  conversionFactorToBase     Decimal        @default(1) @map("conversion_factor_to_base") @db.Decimal(18, 6)
  baseQuantity               Decimal        @map("base_quantity") @db.Decimal(18, 6)
  unitPriceTnd               Decimal        @map("unit_price_tnd") @db.Decimal(14, 3)
  priceBasisUnitId           String         @map("price_basis_unit_id")
  lineCostTnd                Decimal        @map("line_cost_tnd") @db.Decimal(14, 3)
  enteredUnitNameSnapshot    String         @map("entered_unit_name_snapshot")
  priceBasisUnitNameSnapshot String         @map("price_basis_unit_name_snapshot")
  position                   Int
  createdAt                  DateTime       @default(now()) @map("created_at")
  simulation                 CostSimulation @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  rawMaterial                RawMaterial?   @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  enteredUnit                Unit           @relation("CostSimulationEnteredUnit", fields: [enteredUnitId], references: [id], onDelete: Restrict)
  priceBasisUnit             Unit           @relation("CostSimulationPriceBasisUnit", fields: [priceBasisUnitId], references: [id], onDelete: Restrict)

  @@index([simulationId])
  @@index([rawMaterialId])
  @@index([enteredUnitId])
  @@index([priceBasisUnitId])
  @@map("cost_simulation_ingredients")
}

model ExpenseCategory {
  id              String    @id @default(cuid())
  name            String
  normalizedName  String    @map("normalized_name")
  description     String?
  isActive        Boolean   @default(true) @map("is_active")
  version         Int       @default(1)
  createdByUserId String    @map("created_by_user_id")
  updatedByUserId String    @map("updated_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  expenses        Expense[]

  @@index([isActive])
  @@index([normalizedName])
  @@map("expense_categories")
}

/// A recorded operating expense. It has no stock and no party-balance effect;
/// it records that money left the business for a category. Treasury accounts
/// and payroll stay deferred (EXP-009, EXP-010).
model Expense {
  id                 String          @id @default(cuid())
  reference          String          @unique
  categoryId         String          @map("category_id")
  status             ExpenseStatus   @default(DRAFT)
  expenseDate        DateTime        @map("expense_date")
  amountTnd          Decimal         @map("amount_tnd") @db.Decimal(14, 3)
  description        String
  /// Optional supplier receipt or invoice number, distinct from the generated
  /// document reference above.
  externalReference  String?         @map("external_reference")
  method             PaymentMethod   @default(CASH)
  notes              String?
  responsibleUserId  String          @map("responsible_user_id")
  postedAt           DateTime?       @map("posted_at")
  postedByUserId     String?         @map("posted_by_user_id")
  cancelledAt        DateTime?       @map("cancelled_at")
  cancelledByUserId  String?         @map("cancelled_by_user_id")
  cancellationReason String?         @map("cancellation_reason")
  version            Int             @default(1)
  createdByUserId    String          @map("created_by_user_id")
  updatedByUserId    String          @map("updated_by_user_id")
  correlationId      String?         @map("correlation_id")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  category           ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@index([status, expenseDate])
  @@map("expenses")
}

enum ExpenseStatus {
  DRAFT
  POSTED
  CANCELLED
}

model IdempotencyRecord {
  id          String   @id @default(cuid())
  scope       String
  key         String
  requestHash String   @map("request_hash")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([scope, key])
  @@index([createdAt])
  @@map("idempotency_records")
}
