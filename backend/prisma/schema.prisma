generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  displayName   String
  passwordHash  String        @map("password_hash")
  isActive      Boolean       @default(true) @map("is_active")
  deactivatedAt DateTime?     @map("deactivated_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  sessions      AuthSession[]
  roles         UserRole[]
  auditEvents   AuditEvent[]  @relation("AuditActor")

  @@index([isActive])
  @@map("users")
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Permission {
  key           String           @id
  module        String
  labelFr       String           @map("label_fr")
  descriptionFr String           @map("description_fr")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  roles         RolePermission[]

  @@index([module])
  @@map("permissions")
}

model Role {
  id          String           @id @default(cuid())
  name        String
  description String?
  isActive    Boolean          @default(true) @map("is_active")
  isSystem    Boolean          @default(false) @map("is_system")
  systemKey   String?          @unique @map("system_key")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]
  users       UserRole[]

  @@index([isActive])
  @@map("roles")
}

model RolePermission {
  roleId        String     @map("role_id")
  permissionKey String     @map("permission_key")
  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)
  createdAt     DateTime   @default(now()) @map("created_at")

  @@id([roleId, permissionKey])
  @@index([permissionKey])
  @@map("role_permissions")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model AuditEvent {
  id            String   @id @default(cuid())
  actorUserId   String?  @map("actor_user_id")
  action        String
  entity        String
  targetId      String?  @map("target_id")
  correlationId String?  @map("correlation_id")
  reason        String?
  before        Json?
  after         Json?
  createdAt     DateTime @default(now()) @map("created_at")
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entity, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

model Unit {
  id                     String                      @id @default(cuid())
  code                   String                      @unique
  name                   String
  symbol                 String
  precision              Int                         @default(3)
  isActive               Boolean                     @default(true) @map("is_active")
  createdAt              DateTime                    @default(now()) @map("created_at")
  updatedAt              DateTime                    @updatedAt @map("updated_at")
  products               Product[]
  rawMaterials           RawMaterial[]
  rawMaterialConversions RawMaterialUnitConversion[]

  @@index([isActive])
  @@map("units")
}

model ProductCategory {
  id             String    @id @default(cuid())
  name           String
  normalizedName String    @map("normalized_name")
  description    String?
  isActive       Boolean   @default(true) @map("is_active")
  createdByUserId String   @map("created_by_user_id")
  updatedByUserId String   @map("updated_by_user_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  products       Product[]

  @@index([isActive])
  @@index([normalizedName])
  @@map("product_categories")
}

model Product {
  id              String          @id @default(cuid())
  code            String?
  barcode         String?
  name            String
  normalizedName  String          @map("normalized_name")
  categoryId      String          @map("category_id")
  baseUnitId      String          @map("base_unit_id")
  salePriceTnd    Decimal         @map("sale_price_tnd") @db.Decimal(12, 3)
  isStockable     Boolean         @default(true) @map("is_stockable")
  isActive        Boolean         @default(true) @map("is_active")
  notes           String?
  version         Int             @default(1)
  createdByUserId String          @map("created_by_user_id")
  updatedByUserId String          @map("updated_by_user_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  category        ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  baseUnit        Unit            @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)

  @@index([categoryId])
  @@index([baseUnitId])
  @@index([isActive])
  @@index([normalizedName])
  @@map("products")
}

model RawMaterial {
  id              String                      @id @default(cuid())
  code            String?
  name            String
  normalizedName  String                      @map("normalized_name")
  category        String?
  baseUnitId      String                      @map("base_unit_id")
  isActive        Boolean                     @default(true) @map("is_active")
  notes           String?
  version         Int                         @default(1)
  createdByUserId String                      @map("created_by_user_id")
  updatedByUserId String                      @map("updated_by_user_id")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")
  baseUnit        Unit                        @relation(fields: [baseUnitId], references: [id], onDelete: Restrict)
  conversions     RawMaterialUnitConversion[]

  @@index([baseUnitId])
  @@index([isActive])
  @@index([normalizedName])
  @@map("raw_materials")
}

model RawMaterialUnitConversion {
  id            String      @id @default(cuid())
  rawMaterialId String      @map("raw_material_id")
  unitId        String      @map("unit_id")
  factorToBase  Decimal     @map("factor_to_base") @db.Decimal(18, 6)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  rawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: Restrict)

  @@unique([rawMaterialId, unitId])
  @@index([unitId])
  @@index([isActive])
  @@map("raw_material_unit_conversions")
}
