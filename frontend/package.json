{
  "name": "@dar-el-barka/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "api:types": "openapi-typescript ../backend/openapi.json -o src/lib/api/types.gen.ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "api:permissions": "tsx scripts/generatePermissionKeys.ts",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "kit:review": "node scripts/kit-review.mjs",
    "e2e": "playwright test",
    "e2e:seeded": "playwright test -c playwright.seeded.config.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "screen:review": "tsx scripts/screen-review.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-table": "^8.21.3",
    "@vitejs/plugin-react": "^5.0.3",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js-light": "^2.5.1",
    "lucide-react": "^1.47.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.88.0",
    "react-router-dom": "^7.18.4",
    "vite": "^7.1.7",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^27.0.0",
    "lighthouse": "^13.5.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
